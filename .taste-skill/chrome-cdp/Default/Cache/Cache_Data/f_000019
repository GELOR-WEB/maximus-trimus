  }\n}\n\n.chart-bar-fill:hover {\n  filter: brightness(1.3);\n  transform: scaleX(1.1);\n}\n\n.chart-bar-label {\n  font-size: 0.65rem;\n  color: #666;\n  margin-top: 6px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  white-space: nowrap;\n}\n\n/* Tooltip */\n.chart-bar-tooltip {\n  position: absolute;\n  bottom: 100%;\n  left: 50%;\n  transform: translateX(-50%) translateY(-8px);\n  background: #111;\n  border: 1px solid #444;\n  border-radius: 8px;\n  padding: 10px 14px;\n  min-width: 140px;\n  text-align: center;\n  z-index: 50;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity 0.2s ease, transform 0.2s ease;\n  transform: translateX(-50%) translateY(-4px);\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.chart-bar-col:hover .chart-bar-tooltip {\n  opacity: 1;\n  transform: translateX(-50%) translateY(-10px);\n}\n\n/* Keep tooltip visible even at edges */\n.chart-bar-col:first-child .chart-bar-tooltip {\n  left: 0;\n  transform: translateX(0) translateY(-4px);\n}\n\n.chart-bar-col:first-child:hover .chart-bar-tooltip {\n  transform: translateX(0) translateY(-10px);\n}\n\n.chart-bar-col:last-child .chart-bar-tooltip {\n  left: auto;\n  right: 0;\n  transform: translateX(0) translateY(-4px);\n}\n\n.chart-bar-col:last-child:hover .chart-bar-tooltip {\n  transform: translateX(0) translateY(-10px);\n}\n\n.chart-tooltip-label {\n  font-size: 0.75rem;\n  color: #888;\n  white-space: nowrap;\n}\n\n.chart-tooltip-value {\n  font-size: 1.05rem;\n  font-weight: 700;\n  white-space: nowrap;\n}\n\n.chart-tooltip-breakdown {\n  font-size: 0.7rem;\n  color: #666;\n  white-space: nowrap;\n  border-top: 1px solid #2a2a2a;\n  padding-top: 4px;\n  margin-top: 2px;\n}\n\n/* =========================================\n   WHO'S UP NEXT\n   ========================================= */\n.up-next-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.up-next-card {\n  display: flex;\n