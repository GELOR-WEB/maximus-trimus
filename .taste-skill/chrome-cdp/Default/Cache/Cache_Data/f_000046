\r\n  }\r\n\r\n  to {\r\n    transform: translateX(-50%);\r\n  }\r\n}\r\n/* Individual Review Card */\r\n.review-card {\r\n  flex: 0 0 340px;\r\n  min-height: 220px;\r\n  background: rgba(255, 255, 255, 0.04);\r\n  border: 1px solid rgba(255, 255, 255, 0.08);\r\n  border-radius: 16px;\r\n  padding: 28px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n  backdrop-filter: blur(10px);\r\n  -webkit-backdrop-filter: blur(10px);\r\n  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;\r\n  cursor: default;\r\n}\r\n.review-card:hover {\r\n  transform: translateY(-6px);\r\n  border-color: rgba(212, 175, 55, 0.3);\r\n  box-shadow: 0 12px 40px rgba(212, 175, 55, 0.08);\r\n}\r\n.review-card-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n}\r\n.review-avatar {\r\n  width: 46px;\r\n  height: 46px;\r\n  border-radius: 50%;\r\n  background: linear-gradient(135deg, #d4af37, #a27100);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-family: \"Playfair Display\", serif;\r\n  font-size: 1.3rem;\r\n  font-weight: 700;\r\n  color: #0a0a0a;\r\n  flex-shrink: 0;\r\n}\r\n.review-meta {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n.review-name {\r\n  font-family: \"Roboto Slab\", serif;\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  color: white;\r\n}\r\n.review-date {\r\n  font-size: 0.8rem;\r\n  color: #777;\r\n}\r\n.review-stars {\r\n  display: flex;\r\n  gap: 3px;\r\n}\r\n.review-stars .star {\r\n  font-size: 1.1rem;\r\n  color: #444;\r\n  transition: color 0.2s;\r\n}\r\n.review-stars .star.filled {\r\n  color: #d4af37;\r\n  text-shadow: 0 0 6px rgba(212, 175, 55, 0.4);\r\n}\r\n.review-comment {\r\n  font-family: \"Roboto Slab\", serif;\r\n  font-size: 0.95rem;\r\n  line-height: 1.6;\r\n  color: #ccc;\r\n  margin: 0;\r\n  font-style: italic;\r\n  flex-grow: 1;\r\n}\r\n/* Leave a Review Button */\r\n.btn-leave-review {\r\n  margin-top: 30px;\r\n  pad